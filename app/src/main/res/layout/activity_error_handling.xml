
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XỬ LÝ LỖI"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2456B8"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Study Mentor - Error Handling"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KIỂM TRA MẤT MẠNG"
            android:backgroundTint="#6750A4" />

        <EditText
            android:id="@+id/edtQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập câu hỏi thử nghiệm"
            android:inputType="textMultiLine"
            android:layout_marginTop="25dp" />

        <Button
            android:id="@+id/btnInvalid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KIỂM TRA NHẬP SAI"
            android:backgroundTint="#6750A4" />

        <Button
            android:id="@+id/btnTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KIỂM TRA AI KHÔNG PHẢN HỒI"
            android:layout_marginTop="15dp"
            android:backgroundTint="#6750A4" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUAY VỀ TRANG CHỦ"
            android:layout_marginTop="35dp"
            android:backgroundTint="#6750A4" />

    </LinearLayout>
</ScrollView>
